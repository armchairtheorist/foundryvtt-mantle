{
  "name": "foundryvtt-mantle",
  "version": "0.11.0",
  "description": "The Momenta TTRPG as a game system for Foundry Virtual Tabletop",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node tools/check-templates.mjs",
    "verify": "npm run check && npm run check:packs && npm run typecheck && npm test",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:packs": "node tools/build-packs.mjs",
    "extract:packs": "node tools/extract-packs.mjs",
    "link": "node tools/link-system.mjs",
    "check:packs": "node tools/check-packs.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "fvtt-types": "14.366.0-beta.20260817013338",
    "handlebars": "^4.7.9",
    "typescript": "^5.9.3"
  }
}
