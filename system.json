        "htmlFields": [
          "description"
        ]
      },
      "mastery": {
        "htmlFields": [
          "description"
        ]
      },
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armor": {
        "htmlFields": [
          "description"
        ]
      },
      "focus": {
        "htmlFields": [
          "description"
        ]
      },
      "wondrous": {
        "htmlFields": [
          "description"
        ]
      },
      "consumable": {
        "htmlFields": [
          "description"
        ]
      },
      "art": {
        "htmlFields": [
          "description"
        ]
      },
      "resonance": {
        "htmlFields": [
          "description"
        ]
      },
      "feature": {
        "htmlFields": [
          "description"
        ]
      },
      "limitbreak": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "url": "https://github.com/armchairtheorist/foundryvtt-mantle",
  "manifest": "https://github.com/armchairtheorist/foundryvtt-mantle/releases/latest/download/system.json",
