{
  "id": "mantle",
  "title": "Mantle",
  "description": "A tactical, cinematic fantasy TTRPG built around modular archetypes and slottable masteries. Roll pools of d6, read them twice — once for successes, once for patterns.",
  "version": "0.1.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14.366"
  },
  "authors": [
    {
      "name": "Jonathan Wong",
      "url": "https://armchairtheorist.com"
    }
  ],
  "esmodules": [
    "mantle.mjs"
  ],
  "styles": [
    "styles/mantle.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [],
  "grid": {
    "type": 1,
    "distance": 1,
    "units": "sq",
    "diagonals": 0
  },
  "primaryTokenAttribute": "vitality",
  "secondaryTokenAttribute": "guard",
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "biography",
          "notes"
        ]
