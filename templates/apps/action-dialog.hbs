{{!--
  The action roll dialog.

  Every modifier sums before anything is rolled, so the pool readout at the
  bottom is the whole point: it is exactly what will hit the table.
--}}
<form class="mantle action-dialog">

  <label class="row">
    {{localize "MANTLE.Action.attribute"}}
    <select name="attribute">
      {{#each attributes as |attribute|}}
        <option value="{{attribute.key}}" {{#if attribute.selected}}selected{{/if}}>
          {{attribute.label}} ({{attribute.value}}d)
        </option>
      {{/each}}
    </select>
  </label>

  {{!-- A Thread is worth +2d when the GM rules it applies, at most one per
        roll, and never on an attack — so a flat list of the ones this character
        holds is the whole choice. Whether it applies is the table's call. --}}
  <label class="row">
    {{localize "MANTLE.Sheet.threads"}}
    <select name="thread">
      <option value="">{{localize "MANTLE.Field.none"}}</option>
      {{#each threads as |thread|}}
        <option value="{{thread.key}}">{{thread.label}} (+{{../threadBonus}}d)</option>
      {{/each}}
    </select>
  </label>

  {{#unless threads.length}}
    <p class="hint">{{localize "MANTLE.Action.noThreads"}}</p>
  {{/unless}}

  <label class="row">
    {{localize "MANTLE.Condition.impaired"}}
    <input type="number" name="impaired" value="{{impaired}}" min="0" max="10"
           data-tooltip="{{localize 'MANTLE.Action.impairedHint'}}">
  </label>

  <label class="row">
    {{localize "MANTLE.Modifier.situational"}}
    <input type="number" name="situational" value="0" min="-10" max="10"
           data-tooltip="{{localize 'MANTLE.Action.situationalHint'}}">
  </label>

  <div class="action-summary">
    <span class="label">{{localize "MANTLE.Action.pool"}}</span>
    <span class="value" data-pool>0d6</span>
  </div>
</form>
