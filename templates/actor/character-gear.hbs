{{!--
  Gear tab: weapons, armor, spell foci, wondrous items, and known consumables.

  Weapons show their full effect ladder inline, because during a fight that
  ladder is the thing you actually read.
--}}
<section class="tab gear {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="slot-summary">
    <div class="slot-meter {{#if slots.gear.over}}over{{/if}}">
      <span class="label">{{localize slots.gear.label}}</span>
      <span class="count">{{slots.gear.used}} / {{slots.gear.total}}</span>
    </div>
    <div class="slot-meter {{#if slots.wondrous.over}}over{{/if}}">
      <span class="label">{{localize slots.wondrous.label}}</span>
      <span class="count">{{slots.wondrous.used}} / {{slots.wondrous.total}}</span>
    </div>
  </div>

  <div class="section weapons">
    <h3>{{localize "MANTLE.Sheet.weapons"}}</h3>

    {{!-- Every character always has the Unarmed Attack, and it costs no gear
          slot, so it is listed here whether or not the player owns the item. --}}
    {{#unless unarmed.owned}}
      <div class="entry weapon intrinsic">
        <div class="entry-head">
          <i class="fa-solid fa-hand-fist intrinsic-icon"
             data-tooltip="{{localize 'MANTLE.Sheet.intrinsicHint'}}"></i>
          <span class="name">{{unarmed.name}}</span>
          <span class="weight">{{localize (lookup (lookup config.weightClasses unarmed.system.weightClass) "label")}}</span>
          <span class="attribute">{{localize (lookup (lookup config.attributes unarmed.system.attribute) "abbr")}}</span>
          <span class="cost">{{unarmed.system.attackCost}} {{localize "MANTLE.Resource.vigorShort"}}</span>
          <a class="control roll" data-action="rollUnarmed"
             data-tooltip="{{localize 'MANTLE.Sheet.rollAttack'}}"><i class="fa-solid fa-dice-d6"></i></a>
        </div>

        <div class="entry-tags">
          {{#each unarmed.system.damageTypes as |type|}}
            <span class="tag damage">{{localize (lookup ../config.damageTypes type)}}</span>
          {{/each}}
          <span class="tag">{{localize "MANTLE.Tag.melee"}} {{unarmed.system.melee}}</span>
          <span class="tag free">{{localize "MANTLE.Sheet.noSlot"}}</span>
        </div>

        <div class="ladder">
          <span class="band"><b>0s</b> {{unarmed.system.damage.[0]}}</span>
          <span class="band"><b>1s</b> {{unarmed.system.damage.[1]}}</span>
          <span class="band"><b>2s</b> {{unarmed.system.damage.[2]}}</span>
          <span class="band"><b>3+</b> {{unarmed.system.damage.[3]}}</span>
        </div>
      </div>
    {{/unless}}

    {{#each items.weapons as |weapon|}}
      <div class="entry weapon {{#if weapon.system.intrinsic}}intrinsic{{/if}} {{#unless weapon.system.equipped}}unequipped{{/unless}}" data-item-id="{{weapon.id}}">
        <div class="entry-head">
          {{#if weapon.system.intrinsic}}
            <i class="fa-solid fa-hand-fist intrinsic-icon"
               data-tooltip="{{localize 'MANTLE.Sheet.intrinsicHint'}}"></i>
          {{else}}
            <a class="equip-toggle" data-action="toggleEquipped">
              <i class="fa-solid {{#if weapon.system.equipped}}fa-square-check{{else}}fa-square{{/if}}"></i>
            </a>
          {{/if}}
          <span class="name" data-action="editItem">{{weapon.name}}</span>
          <span class="weight">{{localize (lookup (lookup ../config.weightClasses weapon.system.weightClass) "label")}}</span>
          <span class="attribute">{{localize (lookup (lookup ../config.attributes weapon.system.attribute) "abbr")}}</span>
          <span class="cost">{{weapon.system.attackCost}} {{localize "MANTLE.Resource.vigorShort"}}</span>
          <a class="control roll" data-action="rollWeapon"
             data-tooltip="{{localize 'MANTLE.Sheet.rollAttack'}}"><i class="fa-solid fa-dice-d6"></i></a>
          {{#if weapon.system.canDeflect}}
            {{!-- Which weapon deflects decides the attribute rolled, so the
                  reaction is offered on the weapon rather than only in the
                  header. --}}
            <a class="control deflect" data-action="rollDeflect"
               data-tooltip="{{localize 'MANTLE.Reaction.deflectHint'}}"><i class="fa-solid fa-shield-halved"></i></a>
          {{/if}}
          <a class="control" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
        </div>

        <div class="entry-tags">
          {{#each weapon.system.damageTypes as |type|}}
            <span class="tag damage">{{localize (lookup ../../config.damageTypes type)}}</span>
          {{/each}}
          {{#if weapon.system.isMelee}}<span class="tag">{{localize "MANTLE.Tag.melee"}} {{weapon.system.melee}}</span>{{/if}}
          {{#if weapon.system.isRanged}}<span class="tag">{{localize "MANTLE.Tag.range"}} {{weapon.system.range}}</span>{{/if}}
          {{#each weapon.system.tags as |tag|}}
            <span class="tag">{{localize (lookup ../../config.weaponTags tag)}}</span>
          {{/each}}
        </div>

        <div class="ladder">
          <span class="band"><b>0s</b> {{weapon.system.damage.[0]}}</span>
          <span class="band"><b>1s</b> {{weapon.system.damage.[1]}}</span>
          <span class="band"><b>2s</b> {{weapon.system.damage.[2]}}</span>
          <span class="band"><b>3+</b> {{weapon.system.damage.[3]}}</span>
        </div>

        {{#if weapon.system.special}}<p class="special">{{weapon.system.special}}</p>{{/if}}
      </div>
    {{else}}
      <p class="empty">{{localize "MANTLE.Sheet.dropWeapon"}}</p>
    {{/each}}
  </div>

  <div class="section armor">
    <h3>{{localize "MANTLE.Sheet.armor"}}</h3>
    {{#each items.armor as |armor|}}
      <div class="entry {{#unless armor.system.equipped}}unequipped{{/unless}}" data-item-id="{{armor.id}}">
        <a class="equip-toggle" data-action="toggleEquipped">
          <i class="fa-solid {{#if armor.system.equipped}}fa-square-check{{else}}fa-square{{/if}}"></i>
        </a>
        <span class="name" data-action="editItem">{{armor.name}}</span>
        <span class="class">{{localize (lookup ../config.armorClasses armor.system.armorClass)}}</span>
        <span class="effect">+{{armor.system.guard}} {{localize "MANTLE.Sheet.maxGuard"}}</span>
        {{#if armor.system.penalty}}
          <span class="penalty">{{armor.system.penalty}}d {{armor.system.penaltyApplies}}</span>
        {{/if}}
        <a class="control" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{else}}
      <p class="empty">{{localize "MANTLE.Sheet.noArmor"}}</p>
    {{/each}}
  </div>

  <div class="section foci">
    <h3>{{localize "MANTLE.Sheet.foci"}}</h3>
    {{#each items.foci as |focus|}}
      <div class="entry {{#unless focus.system.equipped}}unequipped{{/unless}}" data-item-id="{{focus.id}}">
        <a class="equip-toggle" data-action="toggleEquipped">
          <i class="fa-solid {{#if focus.system.equipped}}fa-square-check{{else}}fa-square{{/if}}"></i>
        </a>
        <span class="name" data-action="editItem">{{focus.name}}</span>
        <span class="effect">{{#if focus.system.effect}}{{focus.system.effect}}{{else}}{{localize "MANTLE.Sheet.basicFocus"}}{{/if}}</span>
        <a class="control" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{else}}
      <p class="empty">{{localize "MANTLE.Sheet.noFoci"}}</p>
    {{/each}}
  </div>

  <div class="section wondrous">
    <h3>{{localize "MANTLE.Sheet.wondrous"}}</h3>
    {{#each items.wondrous as |item|}}
      <div class="entry {{#unless item.system.equipped}}unequipped{{/unless}}" data-item-id="{{item.id}}">
        <a class="equip-toggle" data-action="toggleEquipped">
          <i class="fa-solid {{#if item.system.equipped}}fa-square-check{{else}}fa-square{{/if}}"></i>
        </a>
        <span class="name" data-action="editItem">{{item.name}}</span>
        <span class="effect">{{item.system.effect}}</span>
        <a class="control" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{else}}
      <p class="empty">{{localize "MANTLE.Sheet.noWondrous"}}</p>
    {{/each}}
  </div>

  {{!-- Consumables are not tracked individually; a consumable point buys any
        entry from the common catalog. Exotic ones are listed because they must
        be found first. --}}
  <div class="section consumables">
    <h3>{{localize "MANTLE.Sheet.consumables"}}</h3>
    {{#each items.consumables as |item|}}
      <div class="entry" data-item-id="{{item.id}}">
        <span class="name" data-action="editItem">{{item.name}}</span>
        <span class="category">{{item.system.category}}</span>
        <span class="effect">{{item.system.effect}}</span>
        <a class="control" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{else}}
      <p class="empty">{{localize "MANTLE.Sheet.noConsumables"}}</p>
    {{/each}}
  </div>
</section>
