{{!--
  Skills tab. Training is binary, and one trained skill adds +2d to an action
  roll — at most one per roll, and never to an attack. Click to toggle.
--}}
<section class="tab skills {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <p class="hint">{{localize "MANTLE.Sheet.skillHint"}}</p>

  <div class="skill-groups">
    {{#each skills as |group|}}
      <div class="skill-group">
        <h3>{{localize group.label}}</h3>
        <ul>
          {{#each group.skills as |skill|}}
            <li class="skill {{#if skill.trained}}trained{{/if}}"
                data-action="toggleSkill" data-skill="{{skill.key}}">
              <i class="fa-solid {{#if skill.trained}}fa-square-check{{else}}fa-square{{/if}}"></i>
              {{localize skill.label}}
            </li>
          {{/each}}
        </ul>
      </div>
    {{/each}}
  </div>
</section>
